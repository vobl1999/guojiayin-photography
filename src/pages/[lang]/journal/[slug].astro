---
import { Image, getImage } from 'astro:assets';
import Layout from '../../../components/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, slugFromId } from '../../../lib/utils';
import { SITE } from '../../../config/site';
import { translate, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: slugFromId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: import('astro:content').CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const L: Lang = post.data.lang;
const t = (key: Parameters<typeof translate>[1]) => translate(L, key);
const p = (path: string) => (L === 'zh' ? '/zh' : '/en') + path;

const { Content } = await render(post);

const siblings = (
  await getCollection('posts', ({ data }) => !data.draft && data.lang === L)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = siblings.findIndex((s) => s.id === post.id);
const prev = idx > 0 ? siblings[idx - 1] : undefined;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined;

const cover = post.data.cover;
const coverUrl = cover
  ? (await getImage({ src: cover, widths: [900, 1600, 2200], sizes: '100vw', format: 'webp', quality: 80 })).src
  : undefined;
const description = post.data.description;
const ogImage = coverUrl ? new URL(coverUrl, import.meta.env.SITE).href : undefined;
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;

// 文章结构化数据（BlogPosting + 面包屑）
const articleLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
    author: { '@type': 'Person', name: SITE.name, alternateName: SITE.nameZh, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
    mainEntityOfPage: pageUrl,
    ...(ogImage ? { image: ogImage } : {}),
    inLanguage: L,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('journal.title'),
        item: new URL(p('/journal'), SITE.url).href,
      },
      { '@type': 'ListItem', position: 2, name: post.data.title, item: pageUrl },
    ],
  },
]);

// 文章目录：从 Markdown 的 ## / ### 标题提取（与 rehype-slug 生成的 id 一致）
const slugify = (s: string) =>
  s
    .toLowerCase()
    .trim()
    .replace(/[^\w\u4e00-\u9fff\s-]/g, '')
    .replace(/\s+/g, '-');
const toc = Array.from(post.body?.matchAll(/^##{2,3}\s+(.+)$/gm) ?? []).map((m) => {
  const text = m[1].trim();
  return { level: m[0].startsWith('###') ? 3 : 2, text, id: slugify(text) };
});
---

<Layout
  title={post.data.title}
  description={description}
  ogType="article"
  image={ogImage}
  jsonLd={articleLd}
>
  <div class="reading-progress" data-progress aria-hidden="true"><span></span></div>
  <article>
    <header class="article-head container">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a class="back-link" href={p('/journal')}>{t('journal.title')}</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-here">{post.data.title}</span>
      </nav>
      <h1 class="display-2 article-title">{post.data.title}</h1>
      <div class="article-meta">
        <span>{t('journal.published')} {formatDate(post.data.date, L)}</span>
        {post.data.updated && <span>{t('journal.updated')} {formatDate(post.data.updated, L)}</span>}
        <span>{readingTime(post.body ?? '', L)} {L === 'zh' ? '分钟' : 'min read'}</span>
        {post.data.tags.length > 0 && (
          <span class="j-tags">{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
        )}
      </div>
    </header>

    {
      cover && (
        <figure class="article-cover" data-reveal>
          <Image
            src={cover}
            alt={post.data.coverAlt ?? post.data.title}
            widths={[900, 1600, 2200]}
            sizes="100vw"
            format="webp"
            quality={80}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }

    {
      toc.length > 1 && (
        <details class="toc container-narrow" data-reveal>
          <summary class="label toc-summary">{t('journal.contents')}</summary>
          <ol class="toc-list">
            {toc.map((item) => (
              <li class:list={['toc-item', `toc-level-${item.level}`]}>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="article-body container-narrow">
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="article-nav container" aria-label="Post navigation">
      <a class:list={['article-nav-link', { 'is-empty': !prev }]} href={prev ? p(`/journal/${slugFromId(prev.id)}`) : '#'}>
        <span class="nav-direction">{t('journal.previous')}</span>
        <span class="nav-title">{prev?.data.title ?? '—'}</span>
      </a>
      <a class:list={['article-nav-link is-right', { 'is-empty': !next }]} href={next ? p(`/journal/${slugFromId(next.id)}`) : '#'}>
        <span class="nav-direction">{t('journal.next')}</span>
        <span class="nav-title">{next?.data.title ?? '—'}</span>
      </a>
    </nav>
  </article>
</Layout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 150;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  .back-link {
    color: var(--ink-2);
    transition: color 0.3s;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }

  .crumb-sep {
    color: var(--ink-3);
  }

  .crumb-here {
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .article-head {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .article-head .label {
    margin-bottom: 2rem;
  }

  .article-title {
    max-width: 24ch;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 2rem;
    margin-top: 1.8rem;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .j-tags {
    letter-spacing: 0.08em;
  }

  .article-cover {
    width: var(--container);
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
  }

  .article-cover img {
    width: 100%;
    max-height: 74vh;
    object-fit: cover;
  }

  .article-body {
    padding-block: clamp(2.8rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
  }

  /* 文章目录 */
  .toc {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.1rem 1.4rem;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--paper-deep);
  }

  .toc-summary {
    cursor: pointer;
    color: var(--ink-2);
  }

  .toc[open] .toc-summary {
    margin-bottom: 0.9rem;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    counter-reset: toc;
  }

  .toc-item {
    list-style: none;
  }

  .toc-item a {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: color 0.25s;
  }

  .toc-item a:hover {
    color: var(--gold);
  }

  .toc-level-3 {
    padding-left: 1.2rem;
  }

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--section);
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    transition: background 0.35s;
  }

  .article-nav-link:hover {
    background: var(--paper-deep);
  }

  .article-nav-link.is-right {
    text-align: right;
    align-items: flex-end;
  }

  .article-nav-link.is-empty {
    pointer-events: none;
    opacity: 0.35;
  }

  .nav-direction {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .nav-title {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .article-nav {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 阅读进度条
  (() => {
    const bar = document.querySelector<HTMLElement>('[data-progress] span');
    if (!bar) return;
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
