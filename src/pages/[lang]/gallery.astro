---
import { getImage } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import Reveal from '../../components/Reveal.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import { getAllPhotos } from '../../lib/gallery';
import { SITE } from '../../config/site';
import { translate, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang = 'en' } = Astro.params;
const L: Lang = lang === 'zh' ? 'zh' : 'en';
const t = (key: Parameters<typeof translate>[1]) => translate(L, key);

const photos = await getAllPhotos(L);
const collectionKeys = [...new Set(photos.map((p) => p.collection).filter((c): c is string => !!c))];
const collections = collectionKeys.map((key) => {
  const photo = photos.find((p) => p.collection === key);
  return { key, label: L === 'zh' && photo?.collectionZh ? photo.collectionZh : key };
});
const count = photos.length;

// ImageGallery 结构化数据（利于 Google 图片搜索收录）
const ldImages = await Promise.all(
  photos.slice(0, 20).map(async (photo) => {
    const img = await getImage({ src: photo.src, width: 1200, format: 'jpeg', quality: 80 });
    return new URL(img.src, SITE.url).href;
  })
);
const galleryLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: t('gallery.title'),
  url: new URL(Astro.url.pathname, SITE.url).href,
  image: ldImages,
});
---

<Layout title={t('gallery.title')} description={t('gallery.intro')} jsonLd={galleryLd}>
  <header class="page-head container">
    <Reveal>
      <p class="label">{t('nav.portfolio')}</p>
      <h1 class="display-2 page-title">{t('gallery.title')}</h1>
      <p class="page-intro">{t('gallery.intro')}</p>
      <p class="count label">{translate(L, 'gallery.count', { n: count })}</p>
    </Reveal>
  </header>

  {
    collections.length > 0 && (
      <div class="container chips" data-reveal>
        <button class="chip is-active" data-filter="all">{t('gallery.all')}</button>
        {collections.map((c) => <button class="chip" data-filter={c.key}>{c.label}</button>)}
      </div>
    )
  }

  {
    photos.length === 0 ? (
      <p class="gallery-empty container">
        {L === 'zh'
          ? '相册还是空的 —— 把你的照片放进 src/assets/gallery/ 就会自动显示在这里。'
          : 'The portfolio is empty — drop photographs into src/assets/gallery/ and they will appear here.'}
      </p>
    ) : (
      <section class="gallery-grid" id="gallery" data-r2={SITE.r2Base} aria-label={t('gallery.title')}>
        {
          photos.map((photo, i) => (
            <div
              class="grid-item"
              data-collection={photo.collection ?? ''}
              style={`--reveal-delay:${(i % 3) * 90}ms`}
            >
              <PhotoCard photo={photo} index={i} lightbox />
            </div>
          ))
        }
      </section>
    )
  }
</Layout>

<script>
  // R2 原图下载地址前缀（从页面 data 属性读取，避免 define:vars 导致脚本不编译）
  const r2Base = document.getElementById('gallery')?.dataset.r2 || '';

  // ── 分类筛选 ──────────────────────────────────────────────
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const gridItems = Array.from(document.querySelectorAll<HTMLElement>('.grid-item'));
  let visible: HTMLElement[] = gridItems;

  function applyFilter(filter: string) {
    visible = gridItems.filter(
      (el) => filter === 'all' || el.dataset.collection === filter
    );
    gridItems.forEach((el) => {
      el.classList.toggle('is-hidden', filter !== 'all' && el.dataset.collection !== filter);
    });
    buildStrip();
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      applyFilter(chip.dataset.filter ?? 'all');
      if (lbOpen) closeLightbox();
    });
  });

  // ── Lightbox ─────────────────────────────────────────────
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-photo]'));
  const closeLabel = document.documentElement.lang === 'zh' ? '关闭' : 'Close';
  const prevLabel = document.documentElement.lang === 'zh' ? '上一张' : 'Previous';
  const nextLabel = document.documentElement.lang === 'zh' ? '下一张' : 'Next';
  const downloadLabel = document.documentElement.lang === 'zh' ? '下载原图' : 'Download original';

  const lb = document.createElement('div');
  lb.className = 'lightbox';
  lb.setAttribute('role', 'dialog');
  lb.setAttribute('aria-modal', 'true');
  lb.setAttribute('aria-label', closeLabel);
  lb.innerHTML = `
    <button class="lb-btn lb-close" aria-label="${closeLabel}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button class="lb-btn lb-download" aria-label="${downloadLabel}" title="${downloadLabel}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 4v12m0 0l-4.5-4.5M12 16l4.5-4.5M5 20h14"/></svg>
    </button>
    <button class="lb-btn lb-prev" aria-label="${prevLabel}">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="lb-btn lb-next" aria-label="${nextLabel}">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
    </figure>
    <span class="lb-camera"></span>
    <span class="lb-count"></span>
    <div class="lb-strip"></div>`;
  document.body.appendChild(lb);

  const lbImg = lb.querySelector<HTMLImageElement>('.lb-img')!;
  const lbCount = lb.querySelector<HTMLElement>('.lb-count')!;
  const lbCamera = lb.querySelector<HTMLElement>('.lb-camera')!;
  const lbStrip = lb.querySelector<HTMLElement>('.lb-strip')!;
  let current = 0;
  let lbOpen = false;
  let lastTrigger: HTMLElement | null = null;
  let currentOriginal = '';
  let currentBig = '';

  // 胶片条：按可见列表生成缩略图
  function buildStrip() {
    lbStrip.innerHTML = '';
    const list = visible.filter((el) => el.querySelector('[data-photo]'));
    list.forEach((el, i) => {
      const card = el.querySelector<HTMLElement>('[data-photo]')!;
      const btn = document.createElement('button');
      btn.className = 'lb-thumb';
      btn.setAttribute('aria-label', `${i + 1}`);
      const img = document.createElement('img');
      img.src = card.dataset.thumb ?? card.dataset.src ?? '';
      img.alt = '';
      img.loading = 'lazy';
      btn.appendChild(img);
      btn.addEventListener('click', () => show(i));
      lbStrip.appendChild(btn);
    });
  }
  buildStrip();

  // 缩放状态（点击/滚轮放大看细节）
  let zoom = 1;
  function setZoom(z: number, ox = 0.5, oy = 0.5) {
    zoom = Math.min(4, Math.max(1, z));
    lbImg.style.transformOrigin = `${ox * 100}% ${oy * 100}%`;
    lbImg.style.transform = zoom > 1 ? `scale(${zoom})` : '';
    lbImg.style.cursor = zoom > 1 ? 'zoom-out' : 'zoom-in';
  }
  lbImg.addEventListener('click', (e) => {
    if (zoom > 1) return setZoom(1);
    const r = lbImg.getBoundingClientRect();
    setZoom(2, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
  });
  lbImg.addEventListener('dblclick', () => setZoom(1));
  lbImg.addEventListener(
    'wheel',
    (e) => {
      if (!lbOpen) return;
      e.preventDefault();
      const r = lbImg.getBoundingClientRect();
      const z = e.deltaY < 0 ? zoom * 1.25 : zoom / 1.25;
      setZoom(z, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
    },
    { passive: false }
  );

  // 预加载相邻图片，切换零等待
  function preloadAdjacent(list: HTMLElement[], i: number) {
    for (const offset of [-1, 1]) {
      const el = list[((i + offset) % list.length + list.length) % list.length];
      const src = el?.querySelector<HTMLElement>('[data-photo]')?.dataset.src;
      if (src) {
        const img = new Image();
        img.src = src;
      }
    }
  }

  function show(index: number) {
    const list = visible.filter((el) => el.querySelector('[data-photo]'));
    if (!list.length) return;
    current = (index + list.length) % list.length;
    const card = list[current].querySelector<HTMLElement>('[data-photo]')!;
    lbImg.src = card.dataset.src ?? '';
    lbImg.alt = card.dataset.caption ?? '';
    lbCount.textContent = `${current + 1} / ${list.length}`;
    currentOriginal = card.dataset.original ?? '';
    currentBig = card.dataset.src ?? '';
    lbCamera.textContent = card.dataset.camera ?? '';
    lbCamera.style.display = card.dataset.camera ? '' : 'none';
    setZoom(1);
    preloadAdjacent(list, current);
    // 胶片条高亮当前项并居中
    Array.from(lbStrip.children).forEach((c, i) => c.classList.toggle('is-active', i === current));
    (lbStrip.children[current] as HTMLElement | undefined)?.scrollIntoView({
      behavior: 'smooth',
      inline: 'center',
      block: 'nearest',
    });
  }

  function openLightbox(index: number) {
    show(index);
    lbOpen = true;
    lb.classList.add('is-open');
    document.body.classList.add('no-scroll');
    // 焦点移入 Lightbox，关闭后归还给触发元素
    (lb.querySelector('.lb-close') as HTMLElement | null)?.focus();
  }

  function closeLightbox() {
    lbOpen = false;
    lb.classList.remove('is-open');
    document.body.classList.remove('no-scroll');
    lastTrigger?.focus();
  }

  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      // 用可见列表定位当前卡片，避免筛选后索引错位
      const list = visible.filter((el) => el.querySelector('[data-photo]'));
      const gridItem = card.closest<HTMLElement>('.grid-item');
      const idx = gridItem ? list.indexOf(gridItem) : -1;
      lastTrigger = card;
      openLightbox(idx >= 0 ? idx : 0);
    });
  });

  lb.querySelector('.lb-close')!.addEventListener('click', closeLightbox);
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));

  window.addEventListener('keydown', (e) => {
    if (!lbOpen) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // 触摸滑动
  let startX = 0;
  lb.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
  }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 48) show(current + (dx < 0 ? 1 : -1));
  }, { passive: true });

  lb.addEventListener('click', (e) => {
    if (e.target === lb) closeLightbox();
  });

  // ── 原图下载 + 禁止商用弹窗 ──────────────────────────────
  const licenceTitle = document.documentElement.lang === 'zh' ? '使用须知' : 'Usage Notice';
  const licenceText =
    document.documentElement.lang === 'zh'
      ? '照片仅供个人欣赏与学习使用，禁止任何形式的商用、转载与二次分发。'
      : 'These photographs are for personal viewing and study only. Commercial use, reproduction and redistribution are prohibited.';
  const neverLabel = document.documentElement.lang === 'zh' ? '下次不再提醒' : "Don't ask again";
  const okLabel = document.documentElement.lang === 'zh' ? '好' : 'OK';
  const cancelLabel = document.documentElement.lang === 'zh' ? '取消' : 'Cancel';

  const modal = document.createElement('div');
  modal.className = 'licence-modal';
  modal.setAttribute('role', 'dialog');
  modal.setAttribute('aria-modal', 'true');
  modal.innerHTML = `
    <div class="licence-card">
      <h3 class="licence-title">${licenceTitle}</h3>
      <p class="licence-text">${licenceText}</p>
      <label class="licence-never"><input type="checkbox" class="licence-check" /> ${neverLabel}</label>
      <div class="licence-actions">
        <button class="licence-cancel">${cancelLabel}</button>
        <button class="licence-ok">${okLabel}</button>
      </div>
    </div>`;
  document.body.appendChild(modal);

  let licenceCb: (() => void) | null = null;
  const openLicence = (cb: () => void) => {
    licenceCb = cb;
    modal.classList.add('is-open');
  };
  const closeLicence = () => {
    modal.classList.remove('is-open');
    licenceCb = null;
  };
  modal.querySelector('.licence-ok')!.addEventListener('click', () => {
    const check = modal.querySelector<HTMLInputElement>('.licence-check')!;
    if (check.checked) {
      try {
        localStorage.setItem('licence-accepted', '1');
      } catch {}
    }
    const cb = licenceCb;
    closeLicence();
    cb?.();
  });
  modal.querySelector('.licence-cancel')!.addEventListener('click', closeLicence);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeLicence();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeLicence();
  });

  function triggerDownload(url: string, name: string) {
    const a = document.createElement('a');
    a.href = url;
    if (name) a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function requestDownload(name: string, fallbackSrc: string) {
    // 同域下载通道（Content-Disposition 强制下载），R2 未配置时回退优化图
    const url = r2Base ? `/downloads/${encodeURIComponent(name)}` : fallbackSrc;
    let accepted = false;
    try {
      accepted = localStorage.getItem('licence-accepted') === '1';
    } catch {}
    if (accepted) return triggerDownload(url, name);
    openLicence(() => triggerDownload(url, name));
  }

  // Lightbox 内的下载按钮
  lb.querySelector('.lb-download')!.addEventListener('click', () =>
    requestDownload(currentOriginal, currentBig)
  );

  // 照片卡片上的下载按钮（阻止冒泡，避免同时打开 Lightbox）
  document.querySelectorAll('[data-download]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const anchor = (btn as HTMLElement).closest<HTMLElement>('[data-photo]');
      const name = btn.getAttribute('data-original') ?? '';
      const fallback = anchor?.dataset.src ?? '';
      requestDownload(name, fallback);
    });
  });
</script>

<style>
  .page-head {
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .page-head .label {
    margin-bottom: 1.4rem;
  }

  .page-title {
    margin-bottom: 1.2rem;
  }

  .page-intro {
    max-width: 34rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .count {
    margin-top: 1.6rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-top: clamp(1.6rem, 3vw, 2.4rem);
  }

  .chip {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.55rem 1.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: all 0.35s var(--ease);
  }

  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .gallery-grid {
    width: var(--container);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: clamp(2.2rem, 4vw, 3.2rem) var(--gap);
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section);
  }

  .grid-item {
    transition: opacity 0.5s var(--ease);
  }

  .gallery-empty {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--ink-2);
    padding-block: 5rem var(--section);
  }

  .grid-item.is-hidden {
    display: none;
  }

  /* ── Lightbox ─────────────────────────────── */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(12, 10, 7, 0.93);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease), visibility 0.4s;
  }

  :global(.lightbox.is-open) {
    opacity: 1;
    visibility: visible;
  }

  :global(.lb-figure) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    max-width: min(96vw, 1600px);
  }

  :global(.lb-img) {
    max-width: 94vw;
    /* 底部预留胶片条+文字区域（约 10.5rem），大图不再与缩略图栏重叠 */
    max-height: calc(100vh - 10.5rem);
    object-fit: contain;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s var(--ease);
    cursor: zoom-in;
    user-select: none;
    animation: lb-in 0.28s var(--ease);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :global(.lb-camera) {
    position: fixed;
    bottom: 7rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.4);
    pointer-events: none;
  }

  :global(.lb-count) {
    position: fixed;
    bottom: 5.6rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    font-variant-numeric: tabular-nums;
    color: rgba(244, 241, 234, 0.55);
    pointer-events: none;
  }

  :global(.lb-strip) {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    max-width: 96vw;
    padding: 0.9rem 1rem 1.1rem;
    overflow-x: auto;
    scrollbar-width: none;
    z-index: 301;
  }

  :global(.lb-strip::-webkit-scrollbar) {
    display: none;
  }

  :global(.lb-thumb) {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0.4;
    border: 1px solid transparent;
    padding: 0;
    transition: opacity 0.3s, border-color 0.3s, transform 0.3s;
  }

  :global(.lb-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.lb-thumb:hover) {
    opacity: 0.8;
  }

  :global(.lb-thumb.is-active) {
    opacity: 1;
    border-color: rgba(244, 241, 234, 0.85);
    transform: translateY(-3px);
  }

  :global(.lb-btn) {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: rgba(244, 241, 234, 0.7);
    transition: color 0.3s, transform 0.3s;
  }

  :global(.lb-btn:hover) {
    color: var(--paper);
  }

  :global(.lb-close) {
    top: 1.2rem;
    right: 1.2rem;
  }

  :global(.lb-download) {
    top: 1.2rem;
    right: 4.6rem;
  }

  /* 禁止商用弹窗 */
  :global(.licence-modal) {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(12, 10, 7, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease), visibility 0.3s;
  }

  :global(.licence-modal.is-open) {
    opacity: 1;
    visibility: visible;
  }

  :global(.licence-card) {
    width: min(92vw, 26rem);
    background: var(--paper);
    color: var(--ink);
    border-radius: 10px;
    padding: clamp(1.5rem, 4vw, 2rem);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
  }

  :global(.licence-title) {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 0.7rem;
  }

  :global(.licence-text) {
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  :global(.licence-never) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.3rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    cursor: pointer;
  }

  :global(.licence-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  :global(.licence-cancel) {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: all 0.3s var(--ease);
  }

  :global(.licence-cancel:hover) {
    border-color: var(--ink);
    color: var(--ink);
  }

  :global(.licence-ok) {
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    padding: 0.55rem 1.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.3s;
  }

  :global(.licence-ok:hover) {
    background: var(--gold);
    color: #fff;
