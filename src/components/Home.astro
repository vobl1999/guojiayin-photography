---
import { Image } from 'astro:assets';
import PhotoCard from './PhotoCard.astro';
import { getFeaturedPhotos } from '../lib/gallery';
import { translate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L: Lang = lang;
const t = (key: Parameters<typeof translate>[1]) => translate(L, key);
const p = (path: string) => (L === 'zh' ? '/zh' : '/en') + path;

const photos = await getFeaturedPhotos(L, 5);
const statement = photos[0];
const works = photos.slice(1, 5);
---

<!-- 大字问候（霓虹光斑交互） -->
<section class="hero container" data-reveal>
  <h1 class="hero-hello" data-neon>
    <span class="neon-base">{t('home.hello')}</span>
    <span class="neon-fx" aria-hidden="true">{t('home.hello')}</span>
  </h1>
</section>

<!-- 陈述性大图 -->
{
  statement && (
    <section class="container statement" data-reveal>
      <a
        href={p('/gallery')}
        class="statement-link"
        aria-label="Portfolio"
        style={statement.lqip ? `background-image:url(${statement.lqip})` : undefined}
      >
        <Image
          class="photo-img"
          src={statement.src}
          alt={statement.title}
          widths={[800, 1400, 2000]}
          sizes="(min-width: 900px) 100vw, 100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    </section>
  )
}

<!-- 精选作品 -->
{
  works.length > 0 && (
    <section class="section container">
      <div class="works-grid">
        {
          works.map((photo, i) => (
            <div
              class:list={['works-item', i % 2 === 0 ? 'works-item--wide' : 'works-item--tall']}
              style={`--reveal-delay:${i * 90}ms`}
            >
              <PhotoCard photo={photo} index={i} link={p('/gallery')} />
            </div>
          ))
        }
        {
          works.length >= 4 && (
            <div class="hassel-mark" data-reveal aria-hidden="true"></div>
          )
        }
      </div>
    </section>
  )
}

<style>
  .hero {
    padding-top: clamp(4.5rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    text-align: left;
  }

  .hero-hello {
    position: relative;
    cursor: default;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 500;
    font-size: clamp(2.9rem, 7.5vw, 6.4rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  /* 霓虹层：默认隐藏，跟随鼠标的光斑圈内显示 */
  .neon-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    color: transparent;
    background: linear-gradient(100deg, #ff2d95 0%, #ff8a00 18%, #ffe600 36%, #00e5ff 55%, #b44dff 75%, #ff2d95 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: neon-flow 4s linear infinite;
    filter: drop-shadow(0 0 6px rgba(255, 45, 149, 0.3));
    -webkit-mask-image: radial-gradient(circle var(--neon-r, 0px) at var(--neon-x, 50%) var(--neon-y, 50%), #000 0%, transparent 68%);
    mask-image: radial-gradient(circle var(--neon-r, 0px) at var(--neon-x, 50%) var(--neon-y, 50%), #000 0%, transparent 68%);
    transition: opacity 0.2s ease;
  }

  .hero-hello.is-hover .neon-fx,
  .hero-hello.is-pinned .neon-fx {
    opacity: 1;
  }

  /* 点击固定后：整句霓虹 */
  .hero-hello.is-pinned .neon-fx {
    -webkit-mask-image: none;
    mask-image: none;
  }

  @keyframes neon-flow {
    from {
      background-position: 0% 0;
    }
    to {
      background-position: 300% 0;
    }
  }

  .statement {
    position: relative;
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .statement-link {
    display: block;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .statement-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.8s var(--ease);
  }

  .statement-link:hover img {
    transform: scale(1.02);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    align-items: start;
  }

  .works-item--wide {
    grid-column: span 7;
  }

  .works-item--tall {
    grid-column: span 5;
    margin-top: clamp(2rem, 5vw, 4.5rem);
  }

  /* 让宽卡用 3/2，高卡用 4/5 */
  :global(.works-item--wide .photo-frame) {
    aspect-ratio: 3 / 2;
  }

  /* 哈苏官方字标：嵌在最后两张照片错开形成的左下角空隙里
     字形作为 CSS 遮罩，填充色用主题墨色 → 浅色黑、深色白自动跟随 */
  .hassel-mark {
    grid-row: 2;
    grid-column: 1 / span 7;
    align-self: end;
    justify-self: start;
    /* 负外边距：与右侧高图的下移量一致，底缘对齐高图底边 */
    margin-bottom: calc(clamp(2rem, 5vw, 4.5rem) * -1);
    width: clamp(8rem, 16vw, 13rem);
    aspect-ratio: 76.14 / 5.089;
    background-color: var(--ink);
    -webkit-mask-image: url('/hasselblad-mark.svg');
    mask-image: url('/hasselblad-mark.svg');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    opacity: 0.95;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .works-item--wide,
    .works-item--tall {
      grid-column: span 12;
      margin-top: 0;
    }

    /* 移动端照片堆叠无错开空隙，隐藏商标 */
    .hassel-mark {
      display: none;
    }
  }
</style>

<script>
  // ── 霓虹光斑交互 ─────────────────────────────────────────
  // 老设备 / 不支持的环境（无 PointerEvent、无 background-clip:text、
  // 或用户偏好减少动效）：一律不加特效，保持普通文字
  (() => {
    const el = document.querySelector<HTMLElement>('[data-neon]');
    if (!el) return;

    const supported =
      'PointerEvent' in window &&
      typeof CSS !== 'undefined' &&
      !!CSS.supports &&
      (CSS.supports('background-clip', 'text') ||
        CSS.supports('-webkit-background-clip', 'text')) &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!supported) return;

    el.classList.add('neon-enabled');

    // 点击后一直保持霓虹（跨刷新记住）
    const KEY = 'hello-neon-pinned';
    let pinned = false;
    try {
      pinned = localStorage.getItem(KEY) === '1';
    } catch {}
    if (pinned) el.classList.add('is-pinned');

    const radius = () => Math.min(210, Math.max(130, Math.round(el.offsetWidth / 3)));

    // 鼠标靠近：光斑圆跟随光标，圈内文字变霓虹
    el.addEventListener('pointermove', (e) => {
      if (el.classList.contains('is-pinned')) return;
      const rect = el.getBoundingClientRect();
      el.style.setProperty('--neon-x', `${e.clientX - rect.left}px`);
      el.style.setProperty('--neon-y', `${e.clientY - rect.top}px`);
      el.style.setProperty('--neon-r', `${radius()}px`);
      el.classList.add('is-hover');
    });

    el.addEventListener('pointerleave', () => {
      el.classList.remove('is-hover');
      el.style.setProperty('--neon-r', '0px');
    });

    // 点击（手机端轻触）→ 整句一直霓虹；再点一下恢复
    el.addEventListener('click', () => {
      const now = el.classList.toggle('is-pinned');
      try {
        localStorage.setItem(KEY, now ? '1' : '0');
      } catch {}
    });
  })();
</script>
