---
import { Image } from 'astro:assets';
import Reveal from './Reveal.astro';
import PhotoCard from './PhotoCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { getFeaturedPhotos } from '../lib/gallery';
import { formatDateShort, readingTime, slugFromId } from '../lib/utils';
import { SITE } from '../config/site';
import { translate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L: Lang = lang;
const t = (key: Parameters<typeof translate>[1]) => translate(L, key);
const p = (path: string) => (L === 'zh' ? '/zh' : '/en') + path;

const [photos, posts, aboutEntry] = await Promise.all([
  getFeaturedPhotos(L, 5),
  getCollection('posts', ({ data }) => !data.draft && data.lang === L),
  getEntry('pages', L === 'zh' ? 'about-zh' : 'about-en'),
]);

const postsSorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const statement = photos[0];
const works = photos.slice(1, 5);
const recentPosts = postsSorted.slice(0, 3);
const portrait = aboutEntry?.data.portrait;
const aboutIntro = aboutEntry?.data.intro;
---

<!-- Hero -->
<section class="hero">
  <div class="container hero-inner">
    <Reveal>
      <p class="label">{t('hero.kicker')}</p>
    </Reveal>
    <Reveal delay={80}>
      <h1 class="display-1 hero-headline" set:html={t('hero.headline')} />
    </Reveal>
    <div class="hero-foot">
      <Reveal delay={160}>
        <p class="hero-sub">{t('hero.sub')}</p>
      </Reveal>
      <Reveal delay={240}>
        <div class="hero-cta">
          <a class="link" href={p('/gallery')}>{t('gallery.title')}<span class="arrow">&nbsp;→</span></a>
          <a class="link" href={p('/journal')}>{t('journal.title')}<span class="arrow">&nbsp;→</span></a>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<!-- 陈述性大图 -->
{
  statement && (
    <section class="container statement" data-reveal>
      <a href={p('/gallery')} class="statement-link">
        <Image
          src={statement.src}
          alt={statement.title}
          widths={[800, 1400, 2000]}
          sizes="(min-width: 900px) 100vw, 100vw"
          loading="eager"
          decoding="async"
        />
        <span class="statement-caption">
          <span class="photo-title">{statement.title}</span>
          {statement.location && <span class="photo-location">{statement.location}</span>}
        </span>
      </a>
    </section>
  )
}

<!-- 精选作品 -->
{
  works.length > 0 && (
    <section class="section container">
      <Reveal>
        <div class="section-head">
          <div>
            <p class="label">{t('home.selectedSub')}</p>
            <h2 class="display-3 section-title">{t('home.selected')}</h2>
          </div>
          <a class="link" href={p('/gallery')}>{t('home.selectedCta')}<span class="arrow">&nbsp;→</span></a>
        </div>
      </Reveal>
      <div class="works-grid">
        {works.map((photo, i) => (
          <div class:list={['works-item', i % 2 === 0 ? 'works-item--wide' : 'works-item--tall']} style={`--delay:${i * 90}ms`}>
            <PhotoCard photo={photo} index={i} link={p('/gallery')} />
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- 最新日志 -->
{
  recentPosts.length > 0 && (
    <section class="section container">
      <Reveal>
        <div class="section-head">
          <div>
            <p class="label">{t('home.latestSub')}</p>
            <h2 class="display-3 section-title">{t('home.latest')}</h2>
          </div>
          <a class="link" href={p('/journal')}>{t('nav.journal')}<span class="arrow">&nbsp;→</span></a>
        </div>
      </Reveal>
      <div class="journal-list">
        {
          recentPosts.map((post, i) => (
            <Reveal as="div" delay={i * 80}>
              <a class="journal-row" href={p(`/journal/${slugFromId(post.id)}`)}>
                <span class="j-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="j-title">{post.data.title}</span>
                <span class="j-meta">
                  <span>{formatDateShort(post.data.date, L)}</span>
                  <span>{readingTime(post.body ?? '', L)} {L === 'zh' ? '分钟' : 'min'}</span>
                </span>
              </a>
            </Reveal>
          ))
        }
      </div>
    </section>
  )
}

<!-- 关于摄影师 -->
{
  aboutEntry && (
    <section class="section container about-strip">
      <div class="about-strip-grid">
        {portrait && (
          <Reveal>
            <figure class="about-portrait">
              <Image
                src={portrait}
                alt={aboutEntry.data.portraitAlt ?? ''}
                widths={[400, 700, 1000]}
                sizes="(min-width: 900px) 30vw, 90vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </Reveal>
        )}
        <Reveal delay={120}>
          <div class="about-strip-body">
            <p class="label">{t('home.aboutTitle')}</p>
            <h2 class="display-3 about-strip-title">{aboutEntry.data.title}</h2>
            {aboutIntro && <p class="about-strip-intro">{aboutIntro}</p>}
            <a class="link" href={p('/about')}>{t('home.aboutCta')}<span class="arrow">&nbsp;→</span></a>
          </div>
        </Reveal>
      </div>
    </section>
  )
}

<!-- Coda -->
<section class="section--tall container coda" data-reveal>
  <p class="display-2 coda-text" set:html={t('home.coda')} />
</section>

<style>
  .hero {
    padding-top: clamp(4.5rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.6rem, 3.5vw, 2.6rem);
  }

  .hero-headline {
    max-width: 18ch;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 3rem;
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .hero-sub {
    max-width: 30rem;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  .hero-cta {
    display: flex;
    gap: 2.2rem;
    padding-bottom: 0.4rem;
  }

  .statement {
    position: relative;
  }

  .statement-link {
    display: block;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .statement-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.8s var(--ease);
  }

  .statement-link:hover img {
    transform: scale(1.02);
  }

  .statement-caption {
    position: absolute;
    left: 1.4rem;
    bottom: 1.2rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    color: var(--white);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .statement-caption .photo-title {
    font-size: 1.15rem;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4.5vw, 3.2rem);
  }

  .section-title {
    margin-top: 0.6rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    align-items: start;
  }

  .works-item--wide {
    grid-column: span 7;
  }

  .works-item--tall {
    grid-column: span 5;
    margin-top: clamp(2rem, 5vw, 4.5rem);
  }

  /* 让宽卡用 3/2，高卡用 4/5 */
  :global(.works-item--wide .photo-frame) {
    aspect-ratio: 3 / 2;
  }

  .about-strip-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 24rem) 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .about-portrait {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-strip-body {
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .about-strip-intro {
    max-width: 34rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  .coda {
    text-align: center;
    display: flex;
    justify-content: center;
  }

  .coda-text {
    max-width: 22ch;
  }

  @media (max-width: 860px) {
    .hero-foot {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .works-item--wide,
    .works-item--tall {
      grid-column: span 12;
      margin-top: 0;
    }

    .about-strip-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
