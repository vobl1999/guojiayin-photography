---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../lib/gallery';

interface Props {
  photo: Photo;
  index?: number;
  /** 为 true 时启用 Lightbox（相册集使用） */
  lightbox?: boolean;
  /** 非空时整卡链接到该地址（首页使用） */
  link?: string;
}

const { photo, index, lightbox = false, link = '' } = Astro.props;

const big = lightbox
  ? await getImage({ src: photo.src, width: 1400, quality: 74, format: 'webp' })
  : null;
const thumb = lightbox
  ? await getImage({ src: photo.src, width: 240, quality: 72, format: 'webp' })
  : null;

const caption = photo.location
  ? `${photo.title} — ${photo.location}`
  : photo.title;
---

<figure class="photo-card" data-reveal>
  {
    link ? (
      <a
        class="photo-frame photo-frame--link"
        href={link}
        aria-label={photo.title}
        style={photo.lqip ? `background-image:url(${photo.lqip})` : undefined}
      >
        <Image
          class="photo-img"
          src={photo.src}
          alt={photo.title}
          width={800}
          widths={[480, 800]}
          sizes="(min-width: 1200px) 33vw, (min-width: 760px) 50vw, 92vw"
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <a
        class="photo-frame"
        href={lightbox ? `#${photo.base}` : `/${photo.base}/`}
        style={photo.lqip ? `background-image:url(${photo.lqip})` : undefined}
        {...(lightbox
          ? {
              'data-photo': '',
              'data-src': big!.src,
              'data-thumb': thumb!.src,
              'data-caption': caption,
              'data-collection': photo.collection ?? '',
              'data-camera': photo.camera ?? '',
              'data-original': photo.filename,
            }
          : {})}
        aria-label={lightbox ? undefined : photo.title}
      >
        <Image
          class="photo-img"
          src={photo.src}
          alt={photo.title}
          width={800}
          widths={[480, 800]}
          sizes="(min-width: 1200px) 33vw, (min-width: 760px) 50vw, 92vw"
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
        />
        {index !== undefined && <span class="photo-index">{String(index + 1).padStart(2, '0')}</span>}
        {
          lightbox && (
            <span
              class="photo-download"
              data-download
              data-original={photo.filename}
              role="button"
              tabindex="0"
              aria-label="Download original"
            >
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v12m0 0l-4.5-4.5M12 16l4.5-4.5M5 20h14"/></svg>
            </span>
          )
        }
      </a>
    )
  }
</figure>
