---
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2';
import frauncesLatinItalic from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2';
import { SITE } from '../config/site';
import { langFromUrl, alternatePath, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

const LATIN_RANGE =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+2216,U+2218,U+222B,U+FEFF,U+FFFD';

// 只加载 latin 子集；中文走系统宋体/黑体回退（与之前行为一致）
const fontCss = `
@font-face{font-family:'Fraunces Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${frauncesLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
@font-face{font-family:'Fraunces Variable';font-style:italic;font-display:swap;font-weight:100 900;src:url(${frauncesLatinItalic}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
`;

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** 页面级 JSON-LD（如文章的结构化数据），传入序列化后的 JSON 字符串 */
  jsonLd?: string;
}

const {
  title,
  description = SITE.description,
  image,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const lang: Lang = langFromUrl(Astro.url);
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const ogImage = image ?? SITE.ogImage;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.url).href;
const socials = Object.values(SITE.socials).filter((s) => s.url);

// hreflang：中英文页面的互认链接（双语 SEO）
const pathname = Astro.url.pathname;
const enHref = new URL(
  lang === 'zh' ? alternatePath(pathname, 'zh') : pathname === '/' ? '/en' : pathname,
  SITE.url
).href;
const zhHref = new URL(lang === 'zh' ? pathname : alternatePath(pathname, 'en'), SITE.url).href;

// JSON-LD：让搜索引擎把「Guo Jiayin」和「郭嘉胤」关联到本站
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.nameZh,
  url: SITE.url,
  email: SITE.email,
  sameAs: socials.map((s) => s.url),
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Journal`} href="/rss.xml" />
    <style is:global set:html={fontCss} />
    <ClientRouter />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    {ogImage && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {SITE.socials.x?.url && (
      <meta name="twitter:creator" content={`@${SITE.socials.x.url.replace(/\/+$/, '').split('/').pop()}`} />
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={personLd} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <script is:inline>
      // 标记 JS 可用（无 JS 时图片直接显示，避免渐变占位卡住）
      document.documentElement.classList.add('js');
      // 主题：优先用户选择，其次系统偏好（在绘制前应用，避免闪烁）
      (function () {
        try {
          var t = localStorage.getItem('theme-vobl');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容 Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // 滚动渐显（所有 [data-reveal] 元素）
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // ── 图片延迟加载：先让网页渲染完，再开始拉图片 ──────────
      // 1) 立即摘掉所有照片的 src/srcset（页面以模糊缩略图呈现，秒进）
      // 2) 等页面 load 后，用 IntersectionObserver 在图片接近视口时才恢复
      const photos = Array.from(document.querySelectorAll<HTMLImageElement>('img.photo-img'));
      const loadStartedAt = performance.now();
      photos.forEach((img) => {
        img.dataset.srcRaw = img.getAttribute('src') || '';
        img.dataset.srcsetRaw = img.getAttribute('srcset') || '';
        img.removeAttribute('src');
        img.removeAttribute('srcset');
        // 加载完成后淡入；保证模糊缩略图至少展示一小会儿（约 240ms），
        // 即使图片瞬间加载完也能看到"模糊 → 清晰"的过程
        img.addEventListener(
          'load',
          () => {
            const wait = Math.max(0, 240 - (performance.now() - loadStartedAt));
            setTimeout(() => img.classList.add('is-loaded'), wait);
          },
          { once: true }
        );
      });

      const startImageLoading = () => {
        // 图片按 DOM 顺序一张一张加载：上一张完成后再加载下一张
        const queue = photos.slice();
        const loadNext = () => {
          const img = queue.shift();
          if (!img) return;
          if (img.dataset.srcRaw) img.src = img.dataset.srcRaw;
          if (img.dataset.srcsetRaw) img.srcset = img.dataset.srcsetRaw;
          let advanced = false;
          const advance = () => {
            if (advanced) return;
            advanced = true;
            setTimeout(loadNext, 160);
          };
          img.addEventListener('load', advance, { once: true });
          img.addEventListener('error', advance, { once: true });
        };
        loadNext();
      };

      if (document.readyState === 'complete') {
        setTimeout(startImageLoading, 120);
      } else {
        window.addEventListener('load', () => setTimeout(startImageLoading, 120), { once: true });
      }

      // 主题切换 + 浏览器栏配色同步
      const metaTheme = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const toggleButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      );
      const applyMetaTheme = () => {
        if (!metaTheme) return;
        metaTheme.content =
          document.documentElement.getAttribute('data-theme') === 'dark' ? '#131110' : '#f4f1ea';
      };
      const syncToggleAria = () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        toggleButtons.forEach((b) => b.setAttribute('aria-checked', String(isDark)));
      };
      applyMetaTheme();
      syncToggleAria();
      // 用户没手动选过主题时，跟随系统深浅色实时切换
      try {
        if (!localStorage.getItem('theme-vobl')) {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', (e) => {
              document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
              applyMetaTheme();
              syncToggleAria();
            });
        }
      } catch {}
      toggleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next =
            document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme-vobl', next);
          } catch {}
          applyMetaTheme();
          syncToggleAria();
        });
      });
    </script>
  </body>
</html>
